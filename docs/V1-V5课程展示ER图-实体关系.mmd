%% V1-V5 概念 ER 图（旧版，不作为课堂展示依据）
%% 图例：矩形=实体；菱形=关系；圆角矩形=带自身属性的关系实体。
%% 连线数字 1 / N 分别表示“一”和“多”。
flowchart LR
    %% ---------- 实体 ----------
    DEPT["实体：科室"]
    WARD["实体：病区"]
    ROOM["实体：病房"]
    BED["实体：床位"]
    STAFF["实体：职工"]
    USER["实体：系统账号"]
    PATIENT["实体：患者"]
    ITEM["实体：医疗项目/药品"]
    DRUG["实体：药品属性<br/>（医疗项目的子类型）"]

    %% ---------- 纯关系 ----------
    R_DEPT_WARD{"下设"}
    R_WARD_ROOM{"包含"}
    R_ROOM_BED{"配置"}
    R_DEPT_STAFF{"配属"}
    R_STAFF_USER{"绑定"}
    R_ITEM_DRUG{"具有药品属性"}
    R_CURRENT_BED{"当前入住"}

    %% ---------- 关系实体：住院主线 ----------
    ADMISSION(["关系实体：住院记录<br/>患者住入科室，由医生主管"])
    BED_USAGE(["关系实体：床位使用记录<br/>某次住院占用某床位的起止时间"])
    TRANSFER(["关系实体：转床/转科记录"])
    ORDER(["关系实体：医嘱<br/>医生为一次住院开立"])
    ORDER_ITEM(["关系实体：医嘱项目<br/>医嘱包含的医疗项目、剂量和途径"])
    EXECUTION(["关系实体：执行记录<br/>职工实际执行医嘱项目"])
    CHARGE(["关系实体：收费明细<br/>住院产生的每笔费用"])
    SETTLEMENT(["关系实体：出院结算<br/>一次住院最终结算"])

    %% ---------- 住院、床位、转科 ----------
    PATIENT ---|1| R_PATIENT_ADMISSION
    R_PATIENT_ADMISSION{"住院"}
    R_PATIENT_ADMISSION ---|N| ADMISSION
    DEPT ---|1| R_DEPT_ADMISSION
    R_DEPT_ADMISSION{"收治"}
    R_DEPT_ADMISSION ---|N| ADMISSION
    STAFF ---|1| R_DOCTOR_ADMISSION
    R_DOCTOR_ADMISSION{"主管"}
    R_DOCTOR_ADMISSION ---|N| ADMISSION
    BED ---|1| R_CURRENT_BED
    R_CURRENT_BED ---|N| ADMISSION

    ADMISSION ---|1| R_ADMISSION_USAGE
    R_ADMISSION_USAGE{"占用"}
    R_ADMISSION_USAGE ---|N| BED_USAGE
    BED ---|1| R_BED_USAGE
    R_BED_USAGE{"被占用"}
    R_BED_USAGE ---|N| BED_USAGE
    ADMISSION ---|1| R_ADMISSION_TRANSFER
    R_ADMISSION_TRANSFER{"发生"}
    R_ADMISSION_TRANSFER ---|N| TRANSFER

    %% ---------- 医嘱、执行、收费 ----------
    ADMISSION ---|1| R_ADMISSION_ORDER
    R_ADMISSION_ORDER{"开立"}
    R_ADMISSION_ORDER ---|N| ORDER
    STAFF ---|1| R_DOCTOR_ORDER
    R_DOCTOR_ORDER{"开具"}
    R_DOCTOR_ORDER ---|N| ORDER
    ORDER ---|1| R_ORDER_ITEM
    R_ORDER_ITEM{"包含"}
    R_ORDER_ITEM ---|N| ORDER_ITEM
    ITEM ---|1| R_ITEM_ORDER
    R_ITEM_ORDER{"被引用"}
    R_ITEM_ORDER ---|N| ORDER_ITEM
    ORDER_ITEM ---|1| R_ITEM_EXECUTION
    R_ITEM_EXECUTION{"执行"}
    R_ITEM_EXECUTION ---|N| EXECUTION
    STAFF ---|1| R_STAFF_EXECUTION
    R_STAFF_EXECUTION{"负责"}
    R_STAFF_EXECUTION ---|N| EXECUTION
    ADMISSION ---|1| R_ADMISSION_CHARGE
    R_ADMISSION_CHARGE{"产生"}
    R_ADMISSION_CHARGE ---|N| CHARGE
    EXECUTION ---|1| R_EXECUTION_CHARGE
    R_EXECUTION_CHARGE{"计费"}
    R_EXECUTION_CHARGE ---|N| CHARGE
    ITEM ---|1| R_ITEM_CHARGE
    R_ITEM_CHARGE{"作为收费项目"}
    R_ITEM_CHARGE ---|N| CHARGE
    ADMISSION ---|1| R_ADMISSION_SETTLEMENT
    R_ADMISSION_SETTLEMENT{"结算"}
    R_ADMISSION_SETTLEMENT ---|1| SETTLEMENT

    %% ---------- 基础组织关系 ----------
    DEPT ---|1| R_DEPT_WARD
    R_DEPT_WARD ---|N| WARD
    WARD ---|1| R_WARD_ROOM
    R_WARD_ROOM ---|N| ROOM
    ROOM ---|1| R_ROOM_BED
    R_ROOM_BED ---|N| BED
    DEPT ---|1| R_DEPT_STAFF
    R_DEPT_STAFF ---|N| STAFF
    STAFF ---|1| R_STAFF_USER
    R_STAFF_USER ---|1| USER
    ITEM ---|1| R_ITEM_DRUG
    R_ITEM_DRUG ---|0..1| DRUG

    %% 实体为矩形；纯关系为菱形；圆角矩形为关系实体。
    classDef entity fill:#FFFFFF,stroke:#1F2937,stroke-width:2px,color:#111827;
    classDef relationship fill:#FFF7ED,stroke:#C2410C,stroke-width:2px,color:#7C2D12;
    classDef associative fill:#EFF6FF,stroke:#1D4ED8,stroke-width:2px,color:#1E3A8A;
    class DEPT,WARD,ROOM,BED,STAFF,USER,PATIENT,ITEM,DRUG entity;
    class R_DEPT_WARD,R_WARD_ROOM,R_ROOM_BED,R_DEPT_STAFF,R_STAFF_USER,R_ITEM_DRUG,R_CURRENT_BED,R_PATIENT_ADMISSION,R_DEPT_ADMISSION,R_DOCTOR_ADMISSION,R_ADMISSION_USAGE,R_BED_USAGE,R_ADMISSION_TRANSFER,R_ADMISSION_ORDER,R_DOCTOR_ORDER,R_ORDER_ITEM,R_ITEM_ORDER,R_ITEM_EXECUTION,R_STAFF_EXECUTION,R_ADMISSION_CHARGE,R_EXECUTION_CHARGE,R_ITEM_CHARGE,R_ADMISSION_SETTLEMENT relationship;
    class ADMISSION,BED_USAGE,TRANSFER,ORDER,ORDER_ITEM,EXECUTION,CHARGE,SETTLEMENT associative;
